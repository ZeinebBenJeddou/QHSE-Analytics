# ============================================================
# QHSE Analytics — Variables d'environnement
# Copiez ce fichier en .env et remplissez les valeurs réelles
# NE JAMAIS committer le fichier .env dans git
# ============================================================

# Base de données PostgreSQL
DB_USERNAME=qhse_user
DB_PASSWORD=CHANGE_ME_strong_password

# JWT — générer avec : openssl rand -hex 32
JWT_SECRET=CHANGE_ME_generate_with_openssl_rand_hex_32

# Email (Gmail App Password)
MAIL_USERNAME=votre-email@gmail.com
MAIL_PASSWORD=CHANGE_ME_gmail_app_password

# Admin par défaut (changer au premier démarrage)
ADMIN_EMAIL=admin@votre-domaine.com
ADMIN_DEFAULT_PASSWORD=CHANGE_ME_Admin2024@

# Groq API (https://console.groq.com) — plusieurs clés séparées par virgule
GROQ_API_KEYS=gsk_CHANGE_ME_key1,gsk_CHANGE_ME_key2,gsk_CHANGE_ME_key3

# Gemini API — fallback si Groq indisponible (https://aistudio.google.com)
GEMINI_API_KEY=CHANGE_ME

# URL du frontend (pour les liens dans les emails)
FRONTEND_URL=http://localhost:4200
